// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 1. PRODUCTS - Master Data Barang
// ============================================
model Product {
  id            String    @id @default(uuid())
  barcode       String    @unique @db.VarChar(255)
  name          String    @db.VarChar(255)
  unit          String?   @db.VarChar(50)
  sellingPrice  Decimal   @db.Decimal(15, 2) @map("selling_price")
  averageCost   Decimal   @db.Decimal(15, 2) @default(0) @map("average_cost")
  currentStock  Decimal   @db.Decimal(15, 2) @default(0) @map("current_stock")
  minStock      Decimal   @db.Decimal(15, 2) @default(0) @map("min_stock")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id            String    @id @default(uuid())
  invoiceNumber String   @unique @db.VarChar(100) @map("invoice_number")
  supplierId    String    @map("supplier_id")
  purchaseDate  DateTime  @db.Timestamp @map("purchase_date")
  totalAmount   Decimal   @db.Decimal(15, 2) @map("total_amount")
  createdAt     DateTime  @default(now()) @map("created_at")

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String   @map("purchase_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(15, 2)
  costPrice   Decimal  @db.Decimal(15, 2) @map("cost_price")
  subtotal    Decimal  @db.Decimal(15, 2)

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model Sale {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @db.VarChar(100) @map("invoice_number")
  totalAmount   Decimal   @db.Decimal(15, 2) @map("total_amount")
  totalProfit   Decimal   @db.Decimal(15, 2) @map("total_profit")
  paymentMethod String    @db.VarChar(50) @map("payment_method")
  createdAt     DateTime  @default(now()) @map("created_at")

  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id                 String   @id @default(uuid())
  saleId             String   @map("sale_id")
  productId          String   @map("product_id")
  quantity           Decimal  @db.Decimal(15, 2)
  sellingPrice       Decimal  @db.Decimal(15, 2) @map("selling_price")
  costPriceSnapshot  Decimal  @db.Decimal(15, 2) @map("cost_price_snapshot")
  profit             Decimal  @db.Decimal(15, 2)
  subtotal           Decimal  @db.Decimal(15, 2)

  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model StockMovement {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  referenceType  String   @db.VarChar(50) @map("reference_type")
  referenceId    String?  @map("reference_id")
  movementType   String   @db.VarChar(10) @map("movement_type")
  quantity       Decimal  @db.Decimal(15, 2)
  stockBefore    Decimal  @db.Decimal(15, 2) @map("stock_before")
  stockAfter     Decimal  @db.Decimal(15, 2) @map("stock_after")
  createdAt      DateTime @default(now()) @map("created_at")

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}
